%from stagehand.utils import episode_status_icon_info
<div style='padding: 0 64px; display: table; margin: 2em auto'>
    <div>
        <div style='float: left; padding-right: 2em'>
            <form id='filter' action='{{root}}/downloads/'>
            <label for='select-status'>Include</label>
            <select id='select-status' name='status'>
                %for value, label in (('have', 'downloaded'), ('all', 'all')):
                <option value='{{value}}' {{'selected' if status == value else ''}}>{{label}}</option>
                %end
            </select>
            <label for='select-weeks'>from</label>
            <select id='select-weeks' name='weeks'>
                %for value, label in ((1, 'this week'), (2, 'the last 2 weeks'), (4, 'the last month'), (8, 'the last 2 months'), (24, 'the last 6 months')):
                <option value='{{value}}' {{'selected' if weeks == value else ''}}>{{label}}</option>
                %end
            </select>
            </form>
        </div>
        <button type='button' style='float: right' id='button-search'>
            Download Needed Episodes Now
        </button>
    </div>
    <div style='clear: both; padding-top: 0.75em'></div>
    %include('tv/download-needed-episodes.tmpl', root=root, buttonid='button-search', showid='')


    %if not episodes and not manager.retrieve_queue:
        <div style='text-align: center; padding: 1em'>
            <div style='padding: 0.5em 3em; background-color: #fffcd0; border: 1px solid #e5e1a0;
                        display: inline-block; border-radius: 10px; font-size: 120%'>
                No episodes are needed, and no others match the above criteria.
            </div>
        </div>
    %else:
        %include('tv/episode-table-multiselect.tmpl', tableid='episode-list', root=root)

        <table id='episode-list' class='grid align-center interactive' width='100%' style='z-index: 2; position: relative'>
        <thead id='episode-list-header'>
        <tr>
            <th style='padding: 0 0.7em'><input type='checkbox' /></th>
            <th style='text-align: left'>Series</th>
            <th style='padding: 0 0.7em'>#</th>
            <th style='text-align: left'>Episode Name</th>
            <th style='text-align: left'>Date</th>
            <th>Status</th>
        </tr>
        </thead>
        <tbody>
        %if manager.retrieve_queue:
            <tr class='heading' id='group-downloads'>
                <td style='padding: 0'><input type='checkbox' /></td>
                <td colspan="5" style='text-align: left; padding-left: 0.5em'>
                    <b>Queued Downloads</b>
                </td>
            </tr>
            %for ep, results in manager.retrieve_queue:
                <tr id='{{ep.series.id}}-{{ep.code}}' class='ep download' data-href='{{root}}/tv/{{ep.series.id}}'>
                    <td style='padding: 0'><input type='checkbox' /></td>
                    <td style='text-align: left'>{{ep.series.name}}</td>
                    <td style='padding:0'>{{ep.season.number}}x{{ep.number}}</td>
                    <td style='text-align: left'>{{ep.name}}</td>
                    <td style='text-align: left; white-space: nowrap'>
                        {{ep.airdate.strftime('%Y-%m-%d') if ep.airdate else 'Not aired'}}
                    </td>
                %progress = manager.get_episode_retrieve_progress(ep)
                %if progress:
                    <td class='download-progress' title='{{int(progress.speed/1024)}} KB/s'>
                        <progress max='100' value='{{progress.percentage}}'></progress>
                        <span>{{'%.1f' % (progress.pos/1024/1024.0)}} / {{'%.1f' % (progress.max/1024/1024)}} MB</span>
                    </td>
                %else:
                    <td>
                        %icon, title = episode_status_icon_info(ep)
                        <img src='{{root}}/static/img/icon-20-status-{{icon}}.png' alt='{{title}}' title='{{title}}' />
                    </td>
                %end
                </tr>
            %end

        %end
        %last_week = object() # sentinel
        %for ep, icon, title, week in episodes:
            %clamped_week = min(week, 8) if week is not None else None
            %if last_week != clamped_week:
                %last_week = clamped_week
                <tr class='heading' id='group-{{week}}'>
                    <td style='padding: 0'><input type='checkbox' /></td>
                    <td colspan="5" style='text-align: left; padding-left: 0.5em'>
                        %if week == None:
                            <b>Unknown Air Date</b>
                        %elif week == 0:
                            <b>This Week</b>
                        %elif week == 1:
                            <b>Last Week</b>
                        %elif week <= 7:
                            <b>{{week}} Weeks Ago</b>
                        %else:
                            <b>Older than 2 Months</b>
                        %end
                    </td>
                </tr>
            %end
            <tr id='{{ep.series.id}}-{{ep.code}}' class='group-{{week}} ep' data-href='{{root}}/tv/{{ep.series.id}}'>
                <td style='padding: 0'><input type='checkbox' /></td>
                <td style='text-align: left'>{{ep.series.name}}</td>
                <td style='padding:0'>{{ep.season.number}}x{{ep.number}}</td>
                <td style='text-align: left'>{{ep.name}}</td>
                <td style='text-align: left; white-space: nowrap'>
                    {{ep.airdate.strftime('%Y-%m-%d') if ep.airdate else 'Not aired'}}
                </td>
                <td>
                    <img src='{{root}}/static/img/icon-20-status-{{icon}}.png' alt='{{title}}' title='{{title}}' />
                </td>
            </tr>
        %end
        </tbody>
        </table>
    %end
</div>

<script>
{
    linkRows();
    for (const select of $$('#filter select')) {
        select.addEventListener('change', () => select.form.submit());
    }

    // Update progress of active downloads, and reload the page when the
    // download queue changes.
    const shownQueue = {{!json([[ep.series.id, ep.code] for ep, results in manager.retrieve_queue])}};
    stagehand.on('dlprogress', ({ queue }) => {
        let changed = queue.length !== shownQueue.length;
        queue.forEach(([showid, code, progress], idx) => {
            if (shownQueue[idx]?.[0] !== showid || shownQueue[idx]?.[1] !== code) {
                changed = true;
            }
            const cell = document.getElementById(`${showid}-${code}`)?.querySelector('.download-progress');
            if (cell && progress) {
                const [percentage, current, total, speed] = progress;
                $('progress', cell).value = percentage;
                $('span', cell).textContent = `${current} / ${total} MB`;
                cell.title = `${speed} KB/s`;
            }
        });
        if (changed) {
            window.location.reload();
        }
    });
}
</script>

%rebase('layout.tmpl', title='Downloads', section='downloads', subsection='downloads')
